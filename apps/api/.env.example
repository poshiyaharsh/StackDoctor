# Server Environment
NODE_ENV=development
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/stackdoctor

# Session & Security
# Minimum 32-character high-entropy secret for cookie session signing
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# CORS Allowed Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
