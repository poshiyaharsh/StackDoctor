# StackDoctor Environment Configuration (Local Development)

# API Server Configuration
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://stackdoctor:stackdoctor_local_secret_pass@127.0.0.1:27017/stackdoctor_dev?authSource=admin
SESSION_SECRET=dev_session_secret_change_me_in_production_min_32_chars
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Docker MongoDB Settings
MONGO_ROOT_USER=stackdoctor
MONGO_ROOT_PASSWORD=stackdoctor_local_secret_pass
MONGO_DATABASE=stackdoctor_dev
