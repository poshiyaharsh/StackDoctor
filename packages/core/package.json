{
  "name": "@stackdoctor/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./issue-draft": {
      "types": "./dist/issue-draft.d.ts",
      "import": "./dist/issue-draft.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js"
    }
  },
  "dependencies": {
    "@stackdoctor/adapters": "*",
    "@stackdoctor/config": "*",
    "@stackdoctor/rules": "*",
    "@stackdoctor/schemas": "*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  }
