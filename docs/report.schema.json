{
  "$ref": "#/definitions/StackDoctorReport",
  "definitions": {
    "StackDoctorReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "default": "1.0.0"
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1,
          "default": "0.1.0"
        },
        "operatingSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "completed_with_warnings",
            "failed",
            "cancelled"
          ]
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "likely",
                  "possible"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "observed": {
                      "type": "string",
                      "maxLength": 10000
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "collectedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "description",
                    "observed",
                    "source",
                    "collectedAt"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "name",
              "confidence"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "warning",
                  "failed",
                  "skipped",
                  "error"
                ]
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/StackDoctorReport/properties/technologies/items/properties/evidence/items"
                },
                "default": []
              },
              "error": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "title",
              "category",
              "status",
              "durationMs"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "confidence": {
                "$ref": "#/definitions/StackDoctorReport/properties/technologies/items/properties/confidence"
              },
              "status": {
                "$ref": "#/definitions/StackDoctorReport/properties/checks/items/properties/status"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/StackDoctorReport/properties/technologies/items/properties/evidence/items"
                },
                "default": []
              },
              "possibleCauses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "default": []
              },
              "recommendations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "problem": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "relevance": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "commandOrAction": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "expectedResult": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "risks": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "undo": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "verification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "problem",
                    "relevance",
                    "commandOrAction",
                    "expectedResult",
                    "risks",
                    "verification"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "verificationStatus": {
                "type": "string",
                "enum": [
                  "unverified",
                  "verified",
                  "failed"
                ],
                "default": "unverified"
              },
              "docs": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "default": []
              }
            },
            "required": [
              "ruleId",
              "title",
              "category",
              "severity",
              "confidence",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000,
          "default": []
        },
        "summary": {
          "type": "object",
          "properties": {
            "totalChecks": {
              "type": "integer",
              "minimum": 0
            },
            "totalFindings": {
              "type": "integer",
              "minimum": 0
            },
            "bySeverity": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "propertyNames": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            },
            "byStatus": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "propertyNames": {
                "enum": [
                  "passed",
                  "warning",
                  "failed",
                  "skipped",
                  "error"
                ]
              }
            }
          },
          "required": [
            "totalChecks",
            "totalFindings",
            "bySeverity",
            "byStatus"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operatingSystem",
        "startedAt",
        "completedAt",
        "status",
        "projectName",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
